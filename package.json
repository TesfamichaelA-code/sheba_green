  "description": "Hedera Eco-Rewards System - Decentralized backend for ShebaGreen",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
