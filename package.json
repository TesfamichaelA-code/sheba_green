    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "deploy:railway": "railway up",
    "deploy:heroku": "git push heroku main"
  },
  "keywords": [
    "hedera",
