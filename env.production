# Production Environment Configuration
# Copy this to .env.production and update with your production values

# Hedera Configuration
HEDERA_OPERATOR_ID=0.0.6291912
HEDERA_OPERATOR_KEY=your_hedera_private_key_here
HEDERA_NETWORK=testnet

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_here_production
JWT_EXPIRES_IN=24h

# Database Configuration (will be set by hosting platform)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=shebagreen_eco_rewards
PG_USER=postgres
PG_PASSWORD=your_password_here

# Redis Configuration (will be set by hosting platform)
REDIS_URL=redis://localhost:6379

# Server Configuration
NODE_ENV=production
PORT=3000

# CORS Configuration
CORS_ORIGIN=https://your-flutter-app-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
