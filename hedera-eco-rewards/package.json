{
  "name": "hedera-eco-rewards-system",
  "version": "1.0.0",
  "description": "Decentralized backend platform for eco-rewards using Hedera Hashgraph",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage --run",
    "test:e2e": "vitest --config vitest.config.e2e.ts --run",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "test:performance": "vitest --config vitest.config.performance.ts --run",
    "test:security": "vitest --config vitest.config.security.ts --run",
    "test:contract": "vitest --config vitest.config.contract.ts --run",
    "test:integration": "vitest --config vitest.config.integration.ts --run",
    "test:integration:watch": "vitest --config vitest.config.integration.ts",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e && npm run test:performance && npm run test:security && npm run test:contract",
    "test:full-suite": "./scripts/run-integration-tests.sh",
    "test:ci": "npm run test:coverage && npm run test:e2e && npm run test:contract",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "db:migrate": "ts-node src/infrastructure/persistence/migrations/migrate.ts",
    "db:seed": "ts-node src/infrastructure/persistence/seeds/seed.ts",
    "db:reset": "ts-node src/infrastructure/persistence/migrations/reset.ts",
    "docker:build": "docker build -t hedera-eco-rewards:latest .",
    "docker:run": "docker run -p 3000:3000 hedera-eco-rewards:latest",
    "docker:dev": "docker-compose up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:integration": "docker-compose -f docker-compose.integration.yml up --build",
    "docker:integration:down": "docker-compose -f docker-compose.integration.yml down -v",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "deploy:dev": "./scripts/deploy.sh development",
    "deploy:prod": "./scripts/deploy.sh production",
    "health:check": "./scripts/health-check.sh",
    "health:monitor": "./scripts/system-health-check.sh",
    "health:database": "ts-node -e \"import('./src/infrastructure/persistence/database.service').then(m => new m.DatabaseService().healthCheck())\"",
    "health:redis": "ts-node -e \"import('redis').then(redis => redis.createClient().ping())\"",
    "health:hedera": "ts-node -e \"import('./src/infrastructure/hedera/hedera-token-service').then(m => new m.HederaTokenService().healthCheck())\"",
    "backup:full": "./scripts/backup.sh full",
    "backup:db": "./scripts/backup.sh database",
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/"
  },
  "keywords": [
    "hedera",
    "blockchain",
    "eco-rewards",
    "typescript",
    "clean-architecture"
  ],
  "author": "ShebaGreen Team",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/redis": "^4.0.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.0",
    "@types/validator": "^13.11.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.71.1",
    "@stablelib/ed25519": "^1.0.3",
    "@stablelib/random": "^1.0.2",
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.11.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "did-resolver": "^4.1.0",
    "dotenv": "^16.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "inversify": "^6.0.0",
    "isomorphic-dompurify": "^2.9.0",
    "jaeger-client": "^3.19.0",
    "joi": "^17.0.0",
    "jose": "^5.2.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "multiformats": "^13.0.0",
    "pg": "^8.11.0",
    "pg-pool": "^3.6.0",
    "prom-client": "^15.1.0",
    "redis": "^4.6.0",
    "reflect-metadata": "^0.2.2",
    "supertest": "^6.3.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "validator": "^13.11.0",
    "winston": "^3.11.0"
  }
}
