# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
DATABASE_URL=${DATABASE_URL}
DATABASE_HOST=${DATABASE_HOST}
DATABASE_PORT=${DATABASE_PORT}
DATABASE_NAME=${DATABASE_NAME}
DATABASE_USER=${DATABASE_USER}
DATABASE_PASSWORD=${DATABASE_PASSWORD}
DATABASE_SSL=true
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# Redis Configuration
REDIS_URL=${REDIS_URL}
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# Hedera Configuration
HEDERA_NETWORK=mainnet
HEDERA_OPERATOR_ID=${HEDERA_OPERATOR_ID}
HEDERA_OPERATOR_KEY=${HEDERA_OPERATOR_KEY}
HEDERA_MIRROR_NODE_URL=https://mainnet-public.mirrornode.hedera.com

# Security Configuration
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=1h
ENCRYPTION_KEY=${ENCRYPTION_KEY}
BCRYPT_ROUNDS=12

# API Configuration
API_VERSION=v1
API_PREFIX=/api
CORS_ORIGIN=${CORS_ORIGIN}
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=50m
LOG_MAX_FILES=10

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9464
TRACING_ENABLED=true
JAEGER_ENDPOINT=${JAEGER_ENDPOINT}

# External Services
AI_VERIFICATION_SERVICE_URL=${AI_VERIFICATION_SERVICE_URL}
AI_VERIFICATION_API_KEY=${AI_VERIFICATION_API_KEY}
WEBHOOK_SECRET=${WEBHOOK_SECRET}

# Cache Configuration
CACHE_TTL=7200
CACHE_MAX_ITEMS=10000
CACHE_CHECK_PERIOD=300

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=3000
HEALTH_CHECK_INTERVAL=30000

# Performance Configuration
CLUSTER_WORKERS=0
MAX_REQUEST_SIZE=10mb
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6