# Development Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/hedera_eco_rewards_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hedera_eco_rewards_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Hedera Configuration
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.123456
HEDERA_OPERATOR_KEY=your_testnet_private_key_here
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Security Configuration
JWT_SECRET=dev_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=dev_encryption_key_32_chars_long
BCRYPT_ROUNDS=10

# API Configuration
API_VERSION=v1
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=combined
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9464
TRACING_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# External Services
AI_VERIFICATION_SERVICE_URL=http://localhost:8080
AI_VERIFICATION_API_KEY=dev_ai_api_key
WEBHOOK_SECRET=dev_webhook_secret

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_ITEMS=1000
CACHE_CHECK_PERIOD=600

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000