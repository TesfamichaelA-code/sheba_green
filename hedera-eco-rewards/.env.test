# Test Environment Configuration
NODE_ENV=test

# Database Configuration (Test)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hedera_eco_rewards_test
DB_USERNAME=postgres
DB_PASSWORD=password
DB_SSL=false
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Hedera Configuration (Test)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=0.0.123456
HEDERA_OPERATOR_PRIVATE_KEY=test_private_key_here
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Security Configuration (Test)
JWT_SECRET=test_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=test_32_character_encryption_key
HASH_SALT_ROUNDS=4

# External Services (Test)
AI_VERIFICATION_SERVICE_URL=https://api.example.com/verify
AI_VERIFICATION_API_KEY=test_api_key
NOTIFICATION_SERVICE_URL=https://api.example.com/notifications