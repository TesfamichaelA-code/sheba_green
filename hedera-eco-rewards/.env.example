# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Application Environment
NODE_ENV=development

# API Configuration
API_PORT=3000
API_HOST=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hedera_eco_rewards
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TTL=3600

# Hedera Configuration
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=0.0.YOUR_ACCOUNT_ID
HEDERA_OPERATOR_PRIVATE_KEY=your_private_key_here
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_TOKEN_ID=
HEDERA_TREASURY_ACCOUNT_ID=
HEDERA_TREASURY_PRIVATE_KEY=

# Security Configuration
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your_32_character_encryption_key
HASH_SALT_ROUNDS=12

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=false
LOG_FILE_PATH=

# External Services
AI_VERIFICATION_SERVICE_URL=https://api.example.com/verify
AI_VERIFICATION_API_KEY=your_ai_service_api_key
NOTIFICATION_SERVICE_URL=https://api.example.com/notifications